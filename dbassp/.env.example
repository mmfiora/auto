# ── DBAASP Pipeline Environment Configuration ────────────────────────────────
# Copy this file to .env and adjust values as needed.
# Never commit .env to version control.

# ── Logging ───────────────────────────────────────────────────────────────────
# Options: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# ── API Settings ──────────────────────────────────────────────────────────────
DBAASP_API_URL=https://dbaasp.org/peptides/{id}
DBAASP_TIMEOUT=20

# ── Symlinked folder paths (relative to project root) ─────────────────────────
# output_db/ and presentations/ are Windows junctions pointing to Google Drive.
# Change these only if the junction names ever change.
OUTPUT_DB_DIR=output_db
PRESENTATIONS_DIR=presentations
